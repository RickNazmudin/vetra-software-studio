# App Config
NEXT_PUBLIC_APP_NAME="Vetra Software Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase BaaS Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Payment Gateway (Midtrans / Xendit Sandbox)
# Set PAYMENT_PROVIDER to "midtrans" or "xendit"
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY="your-midtrans-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"
MIDTRANS_IS_PRODUCTION="false"

# Xendit Configuration (if using Xendit)
XENDIT_SECRET_KEY="your-xendit-secret-key"
XENDIT_WEBHOOK_VERIFICATION_TOKEN="your-xendit-webhook-token"
